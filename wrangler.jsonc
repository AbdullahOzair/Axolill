{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axonill",
  // Pinned so wrangler can't target the other Cloudflare account on this machine.
  "account_id": "1a14c367c4e8ad130544b018e0722490",
  // Keep the .workers.dev subdomain active alongside the custom domain.
  "workers_dev": true,
  // Built by `opennextjs-cloudflare build` — does not exist until you run it.
  "main": ".open-next/worker.js",
  // Keep the existing compatibility behavior during the adapter upgrade.
  "compatibility_date": "2026-07-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "routes": [
    {
      "pattern": "axonill.com",
      "zone_name": "axonill.com",
      "custom_domain": true
    }
  ],

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },

  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "71001",
      "simple": { "limit": 15, "period": 60 }
    },
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "71002",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "INQUIRY_ANALYTICS_RATE_LIMITER",
      "namespace_id": "71003",
      "simple": { "limit": 30, "period": 60 }
    }
  ],

  // D1 — relational data (see lib/db/schema.ts).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "axonill",
      "database_id": "5c00cd68-79f9-4dc8-9e2f-d6acde6e0f9a",
      // Point wrangler's migration runner at drizzle-kit's output.
      "migrations_dir": "drizzle"
    }
  ],

  // R2 — file uploads (ProjectFile.fileUrl holds the object key).
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "axonill-files"
    }
  ]
}
